{
  "info": {
    "name": "MeetApp API",
    "description": "Postman Collection for MeetApp Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5079",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (Sets Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.accessToken);",
                  "    console.log(\"Token automatically set to collection variable!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrUsername\": \"dogukan@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"yeni_kullanici\",\n  \"email\": \"yeni@example.com\",\n  \"fullName\": \"Yeni Kullanıcı\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Profile",
      "item": [
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/profiles/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profiles",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Me",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Geliştirici, teknoloji meraklısı...\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/profiles/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profiles",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Meetings",
      "item": [
        {
          "name": "Get My Meetings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/meetings?scope=upcoming",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "meetings"
              ],
              "query": [
                {
                  "key": "scope",
                  "value": "upcoming",
                  "description": "Kapsam: 'upcoming', 'past', 'hosted' veya boş"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Meeting",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Örnek Yeni Toplantı\",\n  \"description\": \"API üzerinden oluşturulan test toplantısı\",\n  \"scheduledAt\": \"2026-10-15T14:30:00Z\",\n  \"isInstant\": false,\n  \"maxParticipants\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/meetings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "meetings"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Connections",
      "item": [
        {
          "name": "Get Connections",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/connections",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "connections"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Notifications",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notifications"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
